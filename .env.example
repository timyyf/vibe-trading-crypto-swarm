# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_API_KEY_BACKUP: chave reserva (opcional) do Gemini.
# Em caso de falha/quota/erro da primária, a backup assume automaticamente.
GEMINI_API_KEY_BACKUP=""
# Modelo Gemini usado pelo comitê (default: gemini-2.5-flash).
# Para maior velocidade, pode usar "gemini-2.5-flash-lite".
GEMINI_MODEL="gemini-2.5-flash"
# Orçamento (ms) que o modo HÍBRIDO espera pelos dois provedores em paralelo.
# Se um estourar o tempo, ele entra DEGRADADO e a resposta sai na hora.
HYBRID_BUDGET_MS="12000"

# DEEPSEEK_API_KEY: Required for DeepSeek AI API calls (OpenAI-compatible).
# Com as duas chaves configuradas, o comitê roda em modo HÍBRIDO:
# Gemini cobre 3 especialistas (technical, sentiment, orderbook) e
# DeepSeek cobre 3 (whales, alpha, risk), em paralelo.
DEEPSEEK_API_KEY=""
# Modelo DeepSeek usado pelo comitê (default: deepseek-v4-flash).
DEEPSEEK_MODEL="deepseek-v4-flash"
# Endpoint OpenAI-compatível da DeepSeek.
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SEMANTICA_BASE_URL: URL do sidecar Semantica (ex.: https://<name>.onrender.com).
# Quando vazio/off, o app roda sem memória de longo prazo (degradação graciosa).
SEMANTICA_BASE_URL=""
# Habilita/desabilita a integração com o Semantica.
SEMANTICA_ENABLED="true"
# Injeta precedentes históricos no prompt do comitê (default off).
SEMANTICA_PRECEDENT_INJECTION="false"
